# Copy to .env.local (gitignored) for local development. Placeholder values only.

# The simulated upstream's private key. Read on the server only, inside the
# Route Handlers (ADR-0004, ADR-0005). Never prefix it NEXT_PUBLIC_ and never
# commit a real value; in production it lives in Vercel's encrypted
# environment. `npm run test:bundle` asserts it is absent from the client
# bundle and needs it set (any value) for both the build and the test run.
TASKS_API_KEY=replace-me
